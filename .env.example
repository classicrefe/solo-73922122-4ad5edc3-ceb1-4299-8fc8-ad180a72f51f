# 留空（默认）= 只手动轮转：
#   docker compose exec nginx /usr/local/bin/rotate-nginx-log.sh
# 设为秒数 = nginx 容器按该间隔自动轮转，演示轮转与采集交错
AUTO_ROTATE_INTERVAL=

# collector：每轮对单个文件最多读取的字节数（默认 1 MiB）。
# 大文件按该预算分多轮入仓，单轮内存有硬上限；其余文件每轮照常采集。
READ_CHUNK_BYTES=1048576

# collector：单行最大字节数（不含换行符，默认 256 KiB，不能大于
# READ_CHUNK_BYTES）。超过该长度的行不会被拆分/跳过，文件保留该行起始
# 偏移并在 GET /ingest/progress 的 blocked_reason 中说明阻塞原因。
MAX_LINE_BYTES=262144
